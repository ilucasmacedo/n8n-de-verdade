    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const venda = $('Separar vendas').item.json;\nconst projeto = $('Groner - Buscar Projeto').item.json;\nconst lead = $json;\n\nconst texto = (v) => (v ?? '').toString().trim();\nconst soDigitos = (v) => texto(v).replace(/\\D/g, '');\nconst documento = soDigitos(\n  lead.documento ?? lead.Documento ?? venda.cliente?.documento ?? venda.Cliente?.Documento\n);\nconst gronerSaleId = String(venda.id ?? venda.Id ?? '');\nconst status = venda.status ?? venda.Status ?? venda.statusVenda ?? null;\n\nreturn {\n  json: {\n    gronerSaleId,\n    status,\n    saleNumber: venda.numero ?? venda.Numero ?? gronerSaleId,\n    saleDate: texto(venda.dataVenda ?? venda.DataVenda ?? venda.dataCadastro).slice(0, 10),\n    customer: {\n      name: texto(lead.nome ?? lead.Nome ?? venda.cliente?.nome),\n      document: documento,\n      email: texto(lead.email ?? lead.Email).toLowerCase(),\n      phone: soDigitos(lead.celular ?? lead.Celular),\n    },\n    total: Number(venda.valorTotal ?? venda.ValorTotal ?? venda.total ?? 0),\n    installments: venda.parcelas ?? venda.Parcelas ?? [],\n    items: venda.itens ?? venda.Itens ?? venda.items ?? [],\n    idempotencyKey: gronerSaleId ? 'GRONER:' + gronerSaleId : null,\n    vendaId: venda.id ?? venda.Id ?? null,\n    projetoId: projeto.id ?? venda.projetoId,\n    leadId: lead.id,\n    nome: texto(lead.nome ?? lead.Nome),\n    email: texto(lead.email ?? lead.Email).toLowerCase(),\n    celular: soDigitos(lead.celular ?? lead.Celular),\n    documento,\n    tipoPessoa: documento.length === 14 ? 'Jurídica' : 'Física',\n    cpf: documento.length === 11 ? documento : '',\n    cnpj: documento.length === 14 ? documento : '',\n    cidade: texto(lead.cidade),\n    uf: texto(lead.uf).toUpperCase(),\n    cep: soDigitos(lead.cep),\n    valorTotal: Number(venda.valorTotal ?? venda.ValorTotal ?? 0),\n    descricao: texto(venda.descricao) || ('Venda Groner #' + gronerSaleId),\n    dataVenda: texto(venda.dataVenda ?? venda.DataVenda ?? venda.dataCadastro).slice(0, 10) || $now.toFormat('yyyy-MM-dd'),\n  },\n};"
      },
