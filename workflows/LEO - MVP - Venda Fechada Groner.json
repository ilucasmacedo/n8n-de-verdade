    {
      "parameters": {
        "jsCode": "const input = $input.all();\n\nreturn input.map(item => {\n  const v = item.json;\n  return { json: {\n    gronerRaw: v,\n    gronerSaleId: v.id ?? v.Id ?? null,\n    status: v.status ?? v.Status ?? v.statusVenda ?? null,\n    saleNumber: v.numero ?? v.Numero ?? null,\n    saleDate: v.dataVenda ?? v.DataVenda ?? null,\n    customer: {\n      name: v.cliente?.nome ?? v.Cliente?.Nome ?? null,\n      document: v.cliente?.documento ?? v.Cliente?.Documento ?? null,\n      email: v.cliente?.email ?? v.Cliente?.Email ?? null,\n      phone: v.cliente?.celular ?? v.Cliente?.Celular ?? null\n    },\n    total: v.valorTotal ?? v.ValorTotal ?? v.total ?? v.Total ?? null,\n    installments: v.parcelas ?? v.Parcelas ?? [],\n    items: v.itens ?? v.Itens ?? v.items ?? []\n  }};\n});"
      },
