        "jsCode": "const v = $json;\n\nreturn [{ json: {\n  ...v,\n  contaAzulPayload: {\n    id_cliente: \"TODO-CONTA-AZUL-CLIENTE-ID\",\n    numero: Number(v.saleNumber || 0),\n    situacao: \"APROVADO\",\n    data_venda: v.saleDate ? String(v.saleDate).slice(0, 10) : new Date().toISOString().slice(0, 10),\n    observacoes: `Origem: Groner | Venda: ${v.gronerSaleId}`,\n    itens: (v.items || []).map((item, index) => ({\n      descricao: item.descricao ?? item.nome ?? `Item ${index + 1}`,\n      quantidade: Number(item.quantidade ?? item.qtd ?? 1),\n      valor: Number(item.valor ?? item.valorUnitario ?? 0),\n      id: \"TODO-CONTA-AZUL-PRODUTO-ID\"\n    }))\n  }\n}}];"
      },
