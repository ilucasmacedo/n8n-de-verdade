            },
            {
              "id": "262e3776-46e6-488c-8aec-49bea9a914bd",
              "name": "inicioDoToken",
              "value": "={{ $json.accessToken ? $json.accessToken.slice(0, 10) + '...' : '(sem token)' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a4e612af-2b39-44da-885f-5abce93f6552",
