              "value": "={{ Number($json.body.id || $json.body.leadId || $json.body.Id || $json.id || $json.leadId || 0) }}",
              "type": "number"
            },
            {
              "id": "a11aa101-0001-4001-8001-000000000001",
              "name": "leadId",
              "value": "={{ Number($json.body.leadId || $json.body.id || $json.body.Id || $json.leadId || $json.id || 0) }}",
              "type": "number"
            },
            {
              "id": "a11aa101-0001-4001-8001-000000000002",
              "name": "nome",
              "value": "={{ $json.body.nome || $json.body.Nome || $json.nome || $json.Nome || '' }}",
